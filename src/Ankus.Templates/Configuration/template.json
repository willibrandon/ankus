{
  "$schema": "http://json.schemastore.org/template",
  "author": "Brandon Williams",
  "classifications": ["Database", "PostgreSQL", "Native AOT"],
  "identity": "Ankus.__IDENTITY__.CSharp",
  "name": "__DISPLAY_NAME__",
  "shortName": "__SHORT_NAME__",
  "tags": { "language": "C#", "type": "project" },
  "preferNameDirectory": true,
  "sources": [
    {
      "modifiers": [
        { "exclude": ["**/pg_regress/expected/**", "Frameworks/**"] },
        {
          "condition": "(testFramework != \"mstest\")",
          "exclude": ["global.json", "Directory.Packages.props", "tests/**/BackendTests.cs", "tests/**/ManagedTests.cs", "tests/**/*.csproj", "tests/**/WorkerBackendTests.cs"]
        }
      ]
    },
    { "include": ["**/pg_regress/expected/**"] },
    { "source": "Frameworks/Xunit/", "target": "./", "condition": "(testFramework == \"xunit\")" },
    { "source": "Frameworks/Nunit/", "target": "./", "condition": "(testFramework == \"nunit\")" },
    { "source": "Frameworks/XunitWorker/", "target": "./", "condition": "(testFramework == \"xunit\" && __WORKER__)" },
    { "source": "Frameworks/NunitWorker/", "target": "./", "condition": "(testFramework == \"nunit\" && __WORKER__)" }
  ],
  "symbols": {
    "testFramework": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "mstest",
      "description": "Consumer test framework",
      "choices": [
        { "choice": "mstest", "description": "MSTest" },
        { "choice": "xunit", "description": "xUnit.net v3" },
        { "choice": "nunit", "description": "NUnit" }
      ]
    },
    "frameworkDisplayName": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "testFramework",
        "steps": [
          { "regex": "^mstest$", "replacement": "MSTest" },
          { "regex": "^xunit$", "replacement": "xUnit" },
          { "regex": "^nunit$", "replacement": "NUnit" }
        ]
      },
      "replaces": "__TEST_FRAMEWORK__"
    },
    "projectName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "identity",
      "replaces": "__PROJECT__",
      "fileRename": "__PROJECT__"
    },
    "workerIdentity": {
      "type": "generated",
      "generator": "guid",
      "parameters": { "format": "n", "defaultFormat": "n" },
      "replaces": "__WORKER_ID__"
    },
    "namespace": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "safe_namespace"
    },
    "escapedNamespace": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "namespace",
        "steps": [{
          "regex": "(^|\\.)(abstract|as|base|bool|break|byte|case|catch|char|checked|class|const|continue|decimal|default|delegate|do|double|else|enum|event|explicit|extern|false|finally|fixed|float|for|foreach|goto|if|implicit|in|int|interface|internal|is|lock|long|namespace|new|null|object|operator|out|override|params|private|protected|public|readonly|ref|return|sbyte|sealed|short|sizeof|stackalloc|static|string|struct|switch|this|throw|true|try|typeof|uint|ulong|unchecked|unsafe|ushort|using|virtual|void|volatile|while|__arglist|__makeref|__reftype|__refvalue)(?=\\.|$)",
          "replacement": "$1@$2"
        }]
      },
      "replaces": "__NAMESPACE__"
    },
    "snakeName": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "name",
        "steps": [
          { "regex": "([a-z0-9])([A-Z])", "replacement": "$1_$2" },
          { "regex": "([A-Z])([A-Z][a-z])", "replacement": "$1_$2" },
          { "regex": "[^A-Za-z0-9_]", "replacement": "_" },
          { "regex": "^([0-9])", "replacement": "_$1" }
        ]
      }
    },
    "extensionName": {
      "type": "generated",
      "generator": "casing",
      "parameters": { "source": "snakeName", "toLower": true },
      "replaces": "__EXTENSION__"
    }
  }
}
