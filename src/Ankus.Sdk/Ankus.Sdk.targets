<Project>
  <!-- Repository development uses project references; the NuGet SDK uses the same native targets. -->
  <Import Project="Ankus.props" />
  <PropertyGroup>
    <_AnkusBuildTool>$(MSBuildThisFileDirectory)../Ankus.Build/bin/$(Configuration)/net10.0/Ankus.Build.dll</_AnkusBuildTool>
    <_AnkusDevelopmentRuntimeIdentifier Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_AnkusDevelopmentRuntimeIdentifier>
    <_AnkusDevelopmentRuntimeIdentifier Condition="'$(_AnkusDevelopmentRuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</_AnkusDevelopmentRuntimeIdentifier>
    <AnkusNativeAotSdkPath Condition="'$(AnkusNativeAotSdkPath)' == '' and Exists('$(MSBuildThisFileDirectory)../../artifacts/nativeaot/$(_AnkusDevelopmentRuntimeIdentifier)/aotsdk/System.Private.CoreLib.dll')">$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', 'artifacts', 'nativeaot', '$(_AnkusDevelopmentRuntimeIdentifier)', 'aotsdk'))</AnkusNativeAotSdkPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)../Ankus.Runtime/Ankus.Runtime.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)../Ankus.Generators/Ankus.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishAot" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)../Ankus.Build/Ankus.Build.csproj"
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishAot" />
  </ItemGroup>

  <Import Project="targets/Ankus.Native.targets" />
  <Import Project="targets/Ankus.NativeAot.targets" />
</Project>
