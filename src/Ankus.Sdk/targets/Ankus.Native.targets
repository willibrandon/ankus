<Project>
  <Target Name="_InvalidateAnkusPublication" BeforeTargets="PrepareForBuild" Condition="'$(_IsPublishing)' == 'true'"
          DependsOnTargets="_InvalidateAnkusPublishManifest" />

  <Target Name="_InvalidateAnkusPublishManifest">
    <PropertyGroup>
      <_AnkusPublishedManifest>$(PublishDir.TrimEnd('/').TrimEnd('\'))/ankus.extension.json</_AnkusPublishedManifest>
      <_AnkusPreviousManifest>$(PublishDir.TrimEnd('/').TrimEnd('\'))/ankus.extension.previous.json</_AnkusPreviousManifest>
    </PropertyGroup>
    <Move SourceFiles="$(_AnkusPublishedManifest)" DestinationFiles="$(_AnkusPreviousManifest)"
          Condition="Exists('$(_AnkusPublishedManifest)')" />
  </Target>

  <Target Name="_ValidateAnkusPublish" BeforeTargets="PrepareForPublish" DependsOnTargets="_InvalidateAnkusPublishManifest">
    <Error Condition="'$(PublishAot)' != 'true'" Text="Ankus extensions require PublishAot=true." />
    <Error Condition="'$(OutputType)' != 'Library' or '$(NativeLib)' != 'Shared'"
           Text="Ankus extensions require OutputType=Library and NativeLib=Shared." />
  </Target>

  <Target Name="_PrepareAnkusNativeArtifacts" BeforeTargets="WriteIlcRspFileForCompilation" DependsOnTargets="Compile;SetupOSSpecificProps;_ResolveAnkusExtensionIdentity">
    <PropertyGroup>
      <_AnkusArtifacts>$(NativeIntermediateOutputPath)ankus/</_AnkusArtifacts>
      <_AnkusCommand>dotnet &quot;$(_AnkusBuildTool)&quot; &quot;@(IntermediateAssembly)&quot;</_AnkusCommand>
      <_AnkusCommand>$(_AnkusCommand) &quot;$(_AnkusArtifacts)&quot; $(AnkusPostgresMajor)</_AnkusCommand>
      <_AnkusLibraries>@(AdditionalNativeLibraryDirectories, ';')</_AnkusLibraries>
      <_AnkusCommand>$(_AnkusCommand) &quot;$(CppLinker)&quot; &quot;$(_AnkusLibraries)&quot;</_AnkusCommand>
      <_AnkusCommand>$(_AnkusCommand) &quot;$(AnkusExtensionName)&quot; &quot;$(AnkusExtensionVersion)&quot;</_AnkusCommand>
      <_AnkusCommand>$(_AnkusCommand) &quot;$(NativeBinaryPrefix)$(TargetName)$(NativeBinaryExt)&quot;</_AnkusCommand>
      <_AnkusCommand>$(_AnkusCommand) &quot;$(RuntimeIdentifier)&quot; &quot;$(AnkusPgConfigPath)&quot;</_AnkusCommand>
      <_AnkusCommand>$(_AnkusCommand) &quot;$(TargetTriple)&quot;</_AnkusCommand>
      <_AnkusCommand>$(_AnkusCommand) &quot;$(AnkusExtensionControlFile)&quot;</_AnkusCommand>
      <_AnkusCommand>$(_AnkusCommand) &quot;$(_AnkusArtifacts)version-controls.txt&quot;</_AnkusCommand>
    </PropertyGroup>
    <MakeDir Directories="$(_AnkusArtifacts)" />
    <WriteLinesToFile File="$(_AnkusArtifacts)version-controls.txt" Lines="@(AnkusVersionControlFile->'%(FullPath)')"
                      Overwrite="true" Encoding="UTF-8" />
    <Exec Command="$(_AnkusCommand)" />
    <ReadLinesFromFile File="$(_AnkusArtifacts)exports.txt">
      <Output TaskParameter="Lines" ItemName="_AnkusExport" />
    </ReadLinesFromFile>
    <ReadLinesFromFile File="$(_AnkusArtifacts)libraries.txt">
      <Output TaskParameter="Lines" ItemName="_AnkusNativeLibrary" />
    </ReadLinesFromFile>
    <ItemGroup>
      <DirectPInvoke Include="Ankus.NativeBodies" />
      <IlcArg Include="@(_AnkusExport->'--export-dynamic-symbol:%(Identity)')" />
      <NativeLibrary Include="@(_AnkusNativeLibrary)" />
      <LinkerArg Include="@(_AnkusNativeLibrary->'&quot;%(Identity)&quot;')" />
      <LinkerArg Include="-Wl,-undefined,dynamic_lookup" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
      <FileWrites Include="$(_AnkusArtifacts)**/*" />
    </ItemGroup>
  </Target>

  <Target Name="_PrepareAnkusNativeCalls" BeforeTargets="LinkNative" DependsOnTargets="IlcCompile">
    <PropertyGroup>
      <_AnkusNativeCallsCommand>dotnet &quot;$(_AnkusBuildTool)&quot; binding-link &quot;$(_AnkusBindingsDirectory)native-records.json&quot; &quot;$(AnkusPgConfigPath)&quot; &quot;$(_AnkusArtifacts)&quot;</_AnkusNativeCallsCommand>
      <_AnkusNativeCallsCommand>$(_AnkusNativeCallsCommand) &quot;$(NativeObject)&quot; &quot;$(CppLinker)&quot; &quot;$(_AnkusLibraries)&quot; &quot;$(TargetTriple)&quot;</_AnkusNativeCallsCommand>
      <_AnkusNativeCallsCommand>$(_AnkusNativeCallsCommand) &quot;$(_AnkusBindingCacheDirectory)&quot;</_AnkusNativeCallsCommand>
    </PropertyGroup>
    <Exec Command="$(_AnkusNativeCallsCommand)" />
    <ReadLinesFromFile File="$(_AnkusArtifacts)native-call-libraries.txt">
      <Output TaskParameter="Lines" ItemName="_AnkusNativeCallLibrary" />
    </ReadLinesFromFile>
    <ItemGroup>
      <NativeLibrary Include="@(_AnkusNativeCallLibrary)" />
      <!-- Generated calls must precede the archives that supply their native symbols. -->
      <_AnkusLinkerArgumentsAfterCalls Include="@(LinkerArg)" />
      <LinkerArg Remove="@(LinkerArg)" />
      <LinkerArg Include="@(_AnkusNativeCallLibrary->'&quot;%(Identity)&quot;')" />
      <LinkerArg Include="@(_AnkusLinkerArgumentsAfterCalls)" />
      <FileWrites Include="$(_AnkusArtifacts)**/*" />
    </ItemGroup>
  </Target>

  <Target Name="_QuoteAnkusNativeLibraries" BeforeTargets="LinkNative" DependsOnTargets="_PrepareAnkusNativeCalls" Condition="'$(_targetOS)' != 'win'">
    <!-- .NET 10's Unix targets append NativeLibrary paths to LinkerArg without quoting.
         Quote existing file arguments in place, preserving static-library ordering. -->
    <ItemGroup>
      <_AnkusLinkerArgument Include="@(LinkerArg)">
        <Argument>%(Identity)</Argument>
        <Argument Condition="Exists('%(Identity)')">&quot;%(Identity)&quot;</Argument>
      </_AnkusLinkerArgument>
      <LinkerArg Remove="@(LinkerArg)" />
      <LinkerArg Include="@(_AnkusLinkerArgument->'%(Argument)')" />
    </ItemGroup>
  </Target>

  <Target Name="_PublishAnkusSchema" AfterTargets="Publish" Condition="'$(PublishAot)' == 'true'">
    <Copy SourceFiles="$(_AnkusArtifacts)schema.sql" DestinationFiles="$(PublishDir)$(TargetName).sql" />
    <WriteLinesToFile File="$(_AnkusArtifacts)upgrade-scripts.txt" Lines="@(AnkusUpgradeScript->'%(FullPath)')"
                      Overwrite="true" Encoding="UTF-8" />
    <Exec Command="dotnet &quot;$(_AnkusBuildTool)&quot; publish-sql &quot;$(_AnkusArtifacts.TrimEnd('/').TrimEnd('\'))&quot; &quot;$(PublishDir.TrimEnd('/').TrimEnd('\'))&quot; &quot;$(_AnkusArtifacts)upgrade-scripts.txt&quot; &quot;$(MSBuildProjectDirectory)&quot; &quot;$(AnkusExtensionVersion)&quot;" />
    <ItemGroup>
      <_AnkusPackageFile Include="$(_AnkusArtifacts)extension/$(AnkusExtensionName).control" />
      <_AnkusPackageFile Include="$(_AnkusArtifacts)extension/$(AnkusExtensionName)--$(AnkusExtensionVersion).sql" />
      <_AnkusPackageFile Include="@(AnkusUpgradeScript)" />
      <_AnkusPackageFile Include="@(AnkusVersionControlFile)" />
    </ItemGroup>
    <ItemGroup>
      <FileWrites Include="$(PublishDir)$(TargetName).sql" />
      <FileWrites Include="$(_AnkusArtifacts)upgrade-scripts.txt" />
      <FileWrites Include="$(PublishDir.TrimEnd('/').TrimEnd('\'))/ankus.extension.json" />
      <FileWrites Include="@(_AnkusPackageFile->'$(PublishDir)extension/%(Filename)%(Extension)')" />
    </ItemGroup>
  </Target>
</Project>
