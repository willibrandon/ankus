using Xunit;

namespace __NAMESPACE__.Tests;

public sealed class ManagedTests
{
    [Theory]
    [InlineData(40, 2, 42)]
    [InlineData(-20, 5, -15)]
    public void AddReturnsSum(int left, int right, int expected)
        => Assert.Equal(expected, Functions.Add(left, right));

    [Fact]
    public void AddRejectsOverflow()
        => Assert.Throws<OverflowException>(() => Functions.Add(int.MaxValue, 1));
}
